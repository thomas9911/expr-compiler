fn string_any(string, predicate) do
    if bytes_len(string) == 0 do
        false
    else
        __string_any_loop(string_chars(string), false, predicate)
    end
end

fn __string_any_loop(it, now, predicate) do
    if string_iter_done(it) or now do
        now
    else
        __string_any_loop(it, predicate(string_iter_next(it)), predicate)
    end
end
