fn list_any(xs, predicate) do
    if list_len(xs) == 0 do
        false
    else
        __list_any_loop(xs, 0, list_len(xs), false, predicate)
    end
end

fn __list_any_loop(xs, index, len, now, predicate) do
    if index == len or now do
        now
    else
        __list_any_loop(xs, index + 1, len, predicate(xs[index]), predicate)
    end
end
