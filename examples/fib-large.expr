fn inner_fib(a, b, i, n, do_print):
    if i + 1 == n:
        if do_print:
            print(a)
        b
    else:
        if do_print:
            print(a)
        inner_fib(b, a + b, i + 1, n, do_print)

fn fibonacci(n):
    if n == 0:
        0
    else:
        inner_fib(0, 1, 0, n, true)

fn fibonacci_bigint(n):
    if n == 0:
        bigint_from_int(0)
    else:
        inner_fib(bigint_from_int(0), bigint_from_int(1), 0, n, false)

fn main():
    # calculate to the 92th fibonacci number (max for i64)
    print(fibonacci(92))
    # calculate to the 300th fibonacci number using bigint
    print(fibonacci_bigint(300))
    0
