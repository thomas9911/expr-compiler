# BigInt demo: exact binomial coefficient C(n, k) via factorials.

fn fact(n) do
    fact_acc(n, 1n)
end

fn fact_acc(n, acc) do
    if n == 0 do
        acc
    else
        fact_acc(n - 1, acc * n)
    end
end

fn choose(n, k) do
    fact(n) / (fact(k) * fact(n - k))
end

fn main() do
    print(choose(40, 20))
    0
end
