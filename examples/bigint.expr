# Demonstrates the current BigInt feature set.

fn main() do
    a = bigint_from_int(2147483647)
    b = bigint_from_int(2147483647)
    c = bigint_from_int(10)
    d = bigint_from_int(25)
    e = bigint_from_int(100)
    f = bigint_from_int(7)

    print(a)
    print(bigint_compare(a, b))
    print(a < b)
    print(a + b)
    print(bigint_add(a, b))
    print(a * bigint_from_int(2))
    print(bigint_multiply(a, bigint_from_int(2)))
    print(d - c)
    print(bigint_subtract(c, d))
    print(e / f)
    print(bigint_divide(e, f))

    0
end
