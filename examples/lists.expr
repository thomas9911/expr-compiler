# Use recursion + list_pop to count and sum list items
fn consume(xs, count, total):
    if list_len(xs) == 0:
        print(count)
        print(total)
        0
    else:
        x = list_pop(xs)
        consume(xs, count + 1, total + x)

fn positive(x):
    x > 0

fn main():
    xs = list_map(list_range(1, 5), fn x -> x * x end)
    consume(xs, 0, 0)

    print(list_all([1, 2, 3], positive))
    print(list_all([1, 0, 3], positive))
    print(list_any([1, 0, 3], fn x -> x == 0 end))

    ys = [10, 20, 30]
    print(list_delete(ys, 1))
    print(ys[1])
    print(list_len(ys))
